<?xml version="1.0"?>
<ruleset name="goals-ac">
	<description>PHP_CodeSniffer rules for the goals.ac monorepo (WordPress plugin).</description>

	<file>cms-plugins/wordpress/includes/</file>
	<file>cms-plugins/wordpress/goals-ac.php</file>
	<file>cms-plugins/wordpress/uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>

	<!-- Documentation rules: require class/method docs but skip legacy PEAR file-header tags. -->
	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.FileComment.InvalidPackage"/>
		<exclude name="Squiz.Commenting.FileComment.MissingCategoryTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingAuthorTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingLicenseTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingLinkTag"/>
	</rule>
</ruleset>
