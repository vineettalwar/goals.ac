# Server
PORT=3001

# Shopify App credentials (from Shopify Partners dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# goals.ac HMAC signing key (shared with the SaaS platform; must match site key in CMS)
GOALS_AC_HMAC_KEY=your_hmac_signing_key
# Alias supported by the Shopify app middleware:
# GOALS_AC_SITE_KEY=your_hmac_signing_key

# Optional: default blog ID to publish to (if not provided per-request)
SHOPIFY_DEFAULT_BLOG_ID=gid://shopify/Blog/1
