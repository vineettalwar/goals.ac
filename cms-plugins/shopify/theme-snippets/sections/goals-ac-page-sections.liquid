{% comment %}
  goals.ac — page section metafields renderer (OS 2.0 section)
  Install: copy to theme sections/goals-ac-page-sections.liquid
  Pair with templates/page.goals-ac.json (same theme-snippets folder).
  Reads metafield: page.metafields.goals_ac.content_sections (json).
{% endcomment %}
{% assign sections = page.metafields.goals_ac.content_sections.value %}
{% if sections %}
  {% for block in sections %}
    {% case block.type %}
      {% when 'rich-text' %}
        <div class="goals-ac-rich-text page-width">
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          {{ block.settings.text }}
        </div>
      {% when 'image-with-text' %}
        <div class="goals-ac-image-text page-width">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          {{ block.settings.text }}
        </div>
    {% endcase %}
  {% endfor %}
{% else %}
  <div class="page-width">
    <h1 class="main-page-title">{{ page.title }}</h1>
    {{ page.content }}
  </div>
{% endif %}

{% schema %}
{
  "name": "goals.ac page sections",
  "tag": "section",
  "class": "section-goals-ac-page-sections",
  "settings": []
}
{% endschema %}
