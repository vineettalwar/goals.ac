{
  "name": "@workspace/goals-ac-wp",
  "version": "0.1.0",
  "description": "WordPress plugin for goals.ac — receive AI content, inject schema/llms.txt, export site graph.",
  "private": true,
  "scripts": {
    "wp-env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "package": "bash ./scripts/package-plugin.sh",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/goals-ac-wp -- composer test",
    "test:unit": "composer install --no-interaction --quiet && ./vendor/bin/phpunit",
    "lint": "wp-env run tests-cli --env-cwd=wp-content/plugins/goals-ac-wp -- composer lint"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0"
  }
}
