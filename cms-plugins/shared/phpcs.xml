<?xml version="1.0"?>
<ruleset name="goals-ac-shared">
	<description>PSR-12 rules for the goals.ac shared CMS contract library.</description>

	<file>src/</file>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="8.1-"/>

	<rule ref="PSR12">
		<!-- CMS bootstrap guard: defined(...) || exit; -->
		<exclude name="PSR1.Files.SideEffects"/>
	</rule>
</ruleset>
