<?xml version="1.0"?>
<ruleset name="goals-ac-typo3">
	<description>PSR-12 rules for the goals.ac TYPO3 extension.</description>

	<file>Classes/</file>
	<file>Configuration/</file>
	<file>ext_localconf.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>stubs/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="8.1-"/>

	<rule ref="PSR12"/>
</ruleset>
