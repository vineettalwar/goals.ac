{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bdd4b32a0d2c3e380d9b57dbfaa90fe6",
  "name": "goals-ac",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "goals-ac"
    }
  ],
  // Create on Contact@vineet.de account — replace IDs after wrangler d1/kv create (see docs/deploy-cloudflare.md)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goals-ac",
      "database_id": "09e067c1-7a72-4ce9-85c7-5ec882f87143",
      "migrations_dir": "../../lib/db/migrations-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "goals-ac-next-cache"
    }
  ],
  "kv_namespaces": [
    { "binding": "AI_CACHE", "id": "d986e00b3e7d43f5a6e5e68ab7b48ea7" },
    { "binding": "RATE_LIMIT", "id": "f85bddf77d9a49ed8d165529eead2998" }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "goals-ac-jobs" }
    ]
  },
  "vars": {
    "DB_DIALECT": "d1",
    "NEXTJS_ENV": "production"
  },
  "env": {
    "staging": {
      "account_id": "bdd4b32a0d2c3e380d9b57dbfaa90fe6",
      "name": "goals-ac-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "goals-ac-staging",
          "database_id": "90bf4293-5b6e-4ed3-bc0b-32a700a3ad84",
          "migrations_dir": "../../lib/db/migrations-d1"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "goals-ac-next-cache-staging"
        }
      ],
      "kv_namespaces": [
        { "binding": "AI_CACHE", "id": "48b8c3b28ffa4b70bd98af0e81f48718" },
        { "binding": "RATE_LIMIT", "id": "c7ec7628d6c0457a9d398c6826942fcc" }
      ],
      "queues": {
        "producers": [
          { "binding": "JOBS_QUEUE", "queue": "goals-ac-jobs-staging" }
        ]
      },
      "vars": {
        "DB_DIALECT": "d1",
        "NEXTJS_ENV": "production"
      }
    },
    "production": {
      "account_id": "bdd4b32a0d2c3e380d9b57dbfaa90fe6",
      "name": "goals-ac",
      "vars": {
        "DB_DIALECT": "d1",
        "NEXTJS_ENV": "production"
      }
    }
  }
}
