{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "dev:worker": "export NODE_ENV=development && pnpm run build && pnpm run start:worker",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:worker": "node --enable-source-maps ./dist/worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@workspace/ai-providers": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/connectors": "workspace:*",
    "@workspace/content-engine": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/jobs": "workspace:*",
    "@workspace/security": "workspace:*",
    "@workspace/seo-tools": "workspace:*",
    "@workspace/serp-provider": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.3",
    "node-html-parser": "^7.1.0",
    "pino": "^9",
    "pino-http": "^10",
    "redis": "^5.12.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
