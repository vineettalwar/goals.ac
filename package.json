{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.1",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "node scripts/dev-app.mjs",
    "dev:worker": "pnpm --filter @workspace/worker run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"!./artifacts/goals-ac\" --filter \"./scripts\" --if-present run typecheck",
    "cf:build": "pnpm --filter @workspace/marketing-persona-app run cf:build",
    "cf:preview": "pnpm --filter @workspace/marketing-persona-app run cf:preview",
    "cf:deploy": "echo 'ERROR: goals-ac OpenNext monolith is retired. Use: pnpm run cf:edge:deploy && pnpm run cf:deploy:jobs && pnpm run cf:pages:marketing && pnpm run cf:pages:app' >&2; exit 1",
    "cf:edge:deploy:public": "pnpm --filter @workspace/cf-public-worker run deploy",
    "cf:edge:deploy:read": "pnpm --filter @workspace/cf-read-worker run deploy",
    "cf:edge:deploy:write": "pnpm --filter @workspace/cf-write-worker run deploy",
    "cf:edge:deploy:gateway": "pnpm --filter @workspace/cf-gateway run deploy",
    "cf:edge:deploy": "pnpm run cf:edge:deploy:public && pnpm run cf:edge:deploy:read && pnpm run cf:edge:deploy:write && pnpm run cf:edge:deploy:gateway",
    "cf:pages:marketing": "pnpm --filter @workspace/marketing-pages run pages:deploy",
    "cf:pages:app": "pnpm --filter @workspace/goals-app-ui run pages:deploy",
    "cf:deploy:jobs": "pnpm --filter @workspace/cf-jobs-worker run deploy:production",
    "cf:provision": "node scripts/cf-provision.mjs",
    "cf:migrate:d1": "pnpm --filter @workspace/db run migrate:d1",
    "cf:migrate:d1:local": "pnpm --filter @workspace/db run migrate:d1:local",
    "cf:seed:d1": "pnpm --filter @workspace/db run seed:d1",
    "cf:seed:d1:local": "pnpm --filter @workspace/db run seed:d1:local",
    "cf:hash-password": "pnpm --filter @workspace/db run hash-password",
    "cf:sync-pg-to-d1": "pnpm --filter @workspace/db run sync-pg-to-d1",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:pages:git-setup": "node scripts/cf-pages-git-setup.mjs",
    "cf:typegen": "pnpm --filter @workspace/marketing-persona-app run cf:typegen",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "parity:matrix": "node scripts/generate-parity-matrix.mjs",
    "parity:smoke": "node scripts/parity-smoke.mjs"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.3.0"
  }
}
