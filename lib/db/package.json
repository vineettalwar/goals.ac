{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./d1": "./src/d1.ts",
    "./active-schema": "./src/active-schema.ts",
    "./schema": "./src/schema/index.ts",
    "./schema-sqlite": "./src/schema-sqlite/index.ts",
    "./schema/search_property_connections": "./src/schema/search_property_connections.ts",
    "./schema/*": "./src/schema/*.ts",
    "./migrate": "./src/migrate.ts",
    "./reference-data": "./src/seed-reference-data.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "generate:d1": "node ./scripts/convert-pg-schema-to-sqlite.mjs && drizzle-kit generate --config ./drizzle.d1.config.ts",
    "migrate": "tsx ./src/run-migrate.ts",
    "migrate:d1": "tsx ./src/migrate-d1.ts",
    "migrate:d1:local": "tsx ./src/migrate-d1.ts --local",
    "seed:d1": "tsx ./src/run-seed-d1.ts",
    "seed:d1:local": "tsx ./src/run-seed-d1.ts --local",
    "seed": "tsx ./src/seed.ts",
    "seed-test-user": "tsx ./src/seed-test-user.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
