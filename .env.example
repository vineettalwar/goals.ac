# goals.ac — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goalsac

# Public browser origin(s) allowed to make credentialed API requests.
# Comma-separated for multiple production frontends. Required in production.
APP_ORIGIN=http://localhost:5173,http://localhost:3001

# Marketing Next.js app — public URL + NextAuth
NEXTAUTH_URL=http://localhost:3001
AUTH_SECRET=change-me-generate-a-random-32-char-string

# Marketing site (Next.js) — public URL for CTAs from the Vite app
VITE_MARKETING_URL=http://localhost:3001

# Vite product app — used by Next.js marketing CTAs ("Open app")
NEXT_PUBLIC_APP_URL=http://localhost:5174

# Secret used to sign JWT tokens (30-day expiry).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this invalidates ALL existing user sessions.
JWT_SECRET=change-me-generate-a-random-32-char-string

# Secret used to derive the AES-256-GCM encryption key for:
#   - User-provided Gemini API keys
#   - Notion and Webflow CMS credentials
# WARNING: Changing this makes all stored encrypted values unreadable.
GEMINI_KEY_ENCRYPTION_SECRET=change-me-generate-another-random-32-char-string

# ─────────────────────────────────────────────
# AI GENERATION (at least one is required for content generation)
# ─────────────────────────────────────────────

# Google Gemini API key — platform-level fallback used when no user key is present.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Replit AI Integrations proxy (auto-injected on Replit, not needed locally)
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=

# Active AI provider when not set per-user in app Settings: gemini | bedrock | ollama
# AI_PROVIDER=gemini

# AWS Bedrock — platform-level credentials (used when AI provider is bedrock)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# Ollama — local or remote inference (used when AI provider is ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e2b

# ─────────────────────────────────────────────
# AUTHENTICATION — GOOGLE OAUTH (optional)
# ─────────────────────────────────────────────

# Create OAuth 2.0 credentials at https://console.cloud.google.com/
# Authorized redirect URIs:
#   - http://localhost:3001/api/auth/callback/google (NextAuth login)
#   - http://localhost:3001/api/auth/google-search-console/callback (Search Console)
# Enable "Google Search Console API" in the same Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bing Webmaster Tools OAuth — register at Bing Webmaster → Settings → API Access → OAuth Client
# Redirect URI: http://localhost:3001/api/auth/bing-webmaster/callback
BING_WEBMASTER_CLIENT_ID=
BING_WEBMASTER_CLIENT_SECRET=

# ─────────────────────────────────────────────
# EMAIL (optional — required for password reset)
# ─────────────────────────────────────────────

# Resend API key for transactional emails
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# From address for outbound emails (defaults to noreply@goals.ac)
# RESEND_FROM_EMAIL=noreply@goals.ac

# ─────────────────────────────────────────────
# CACHING (optional — falls back to in-memory LRU)
# ─────────────────────────────────────────────

# Redis URL for AI output caching (24-hour TTL)
# Without this, an in-memory LRU cache (max 500 entries) is used instead.
# REDIS_URL=redis://localhost:6379

# API request protection (optional)
# REQUEST_BODY_LIMIT=1mb
# RATE_LIMIT_MAX=300

# ─────────────────────────────────────────────
# SOCIAL OAUTH (optional — required for social publishing)
# ─────────────────────────────────────────────

# LinkedIn — redirect URI: {API_ORIGIN}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) — redirect URI: {API_ORIGIN}/api/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Meta (Facebook + Instagram) — redirect URI: {API_ORIGIN}/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Bluesky — AT Protocol OAuth (redirect: {NEXTAUTH_URL}/api/auth/bluesky/callback)
# Stable RSA JWK required in production (metadata at /oauth/bluesky-client-metadata.json)
# BLUESKY_CLIENT_NAME=goals.ac
# BLUESKY_OAUTH_PRIVATE_KEY_JWK=

# Mastodon — no global env vars; OAuth apps register dynamically per instance at connect time

# ─────────────────────────────────────────────
# KEYWORD RANK TRACKING (optional — required for SERP rank checks)
# ─────────────────────────────────────────────

# DataForSEO credentials for Google organic rank tracking
# Sign up at https://dataforseo.com/
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SERP_PROVIDER=dataforseo

# Marketing Next.js app BFF proxy to Express API (default: http://localhost:8080/api)
# EXPRESS_API_URL=http://localhost:8080/api

# ─────────────────────────────────────────────
# LEAD CAPTURE (optional)
# ─────────────────────────────────────────────

# Calendly embed URL for /contact demo booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/vineetsktalwar
