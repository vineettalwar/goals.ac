# goals.ac — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goalsac

# Secret used to sign JWT tokens (30-day expiry).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this invalidates ALL existing user sessions.
JWT_SECRET=change-me-generate-a-random-32-char-string

# Secret used to derive the AES-256-GCM encryption key for:
#   - User-provided Gemini API keys
#   - Notion and Webflow CMS credentials
# WARNING: Changing this makes all stored encrypted values unreadable.
GEMINI_KEY_ENCRYPTION_SECRET=change-me-generate-another-random-32-char-string

# ─────────────────────────────────────────────
# AI GENERATION (at least one is required for content generation)
# ─────────────────────────────────────────────

# Google Gemini API key — platform-level fallback used when no user key is present.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Replit AI Integrations proxy (auto-injected on Replit, not needed locally)
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=

# ─────────────────────────────────────────────
# AUTHENTICATION — GOOGLE OAUTH (optional)
# ─────────────────────────────────────────────

# Create OAuth 2.0 credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# EMAIL (optional — required for password reset)
# ─────────────────────────────────────────────

# Resend API key for transactional emails
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# From address for outbound emails (defaults to noreply@goals.ac)
# RESEND_FROM_EMAIL=noreply@goals.ac

# ─────────────────────────────────────────────
# CACHING (optional — falls back to in-memory LRU)
# ─────────────────────────────────────────────

# Redis URL for AI output caching (24-hour TTL)
# Without this, an in-memory LRU cache (max 500 entries) is used instead.
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# LEAD CAPTURE (optional)
# ─────────────────────────────────────────────

# Webhook URL for lead capture events (currently disabled from core flow)
# LEADSH_WEBHOOK_URL=
